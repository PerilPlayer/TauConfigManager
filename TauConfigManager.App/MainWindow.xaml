<Window x:Class="TauConfigManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TAU 配置管理工具" Height="897" Width="1669"
        MinHeight="700" MinWidth="1080" Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <GroupBox Header="设备连接" Grid.Row="0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TAU IP" VerticalAlignment="Center" />
                <TextBox x:Name="HostBox" Grid.Column="1" Text="192.168.17.200" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Column="3" Text="23" Margin="4,0" />
                <TextBlock Grid.Column="4" Text="用户" VerticalAlignment="Center" />
                <TextBox x:Name="UserBox" Grid.Column="5" Text="root" Margin="4,0" />
                <TextBlock Grid.Column="6" Text="密码" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Grid.Column="7" Password="sct123" Margin="4,0" />
                <TextBlock Grid.Column="8" Text="本机 IP" VerticalAlignment="Center" />
                <ComboBox x:Name="LocalAddressBox" Grid.Column="9" Margin="4,0" />
                <Button x:Name="TestButton" Grid.Column="10" Content="测试连接" Width="100" HorizontalAlignment="Left" Click="TestButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Header="操作" Grid.Row="1" Padding="10" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ExportButton" Content="一键导出" Width="100" Margin="0,0,8,0" Click="ExportButton_Click" />
                <Button x:Name="OpenPackageButton" Grid.Column="1" Content="选择配置包" Width="110" Margin="0,0,8,0" Click="OpenPackageButton_Click" />
                <Button x:Name="CompareButton" Grid.Column="2" Content="对比目标设备" Width="120" Margin="0,0,8,0" Click="CompareButton_Click" />
                <Button x:Name="ImportButton" Grid.Column="3" Content="一键导入" Width="100" Margin="0,0,8,0" Click="ImportButton_Click" />
                <Button x:Name="RollbackButton" Grid.Column="4" Content="回滚上次导入" Width="120" Margin="0,0,16,0" Click="RollbackButton_Click" />
                <WrapPanel Grid.Column="5" VerticalAlignment="Center">
                    <CheckBox x:Name="IdentityBox" Content="包含序列号/版本/IMEI" Margin="0,0,12,0" />
                    <CheckBox x:Name="MacBox" Content="包含管理口 MAC" Margin="0,0,12,0" />
                    <CheckBox x:Name="HardwareBox" Content="包含硬件探测配置" Margin="0,0,12,0" />
                    <CheckBox x:Name="LicenseBox" Content="包含 license" Margin="0,0,12,0" />
                    <CheckBox x:Name="ForceImportBox" Content="忽略兼容性错误导入" Margin="0,0,12,0" />
                    <CheckBox x:Name="DeleteMissingBox" Content="删除目标多余配置" IsChecked="True" Margin="0,0,12,0" />
                    <CheckBox x:Name="VerifyImportBox" Content="导入后校验文件" IsChecked="True" Margin="0,0,12,0" />
                    <CheckBox x:Name="PreserveAddressBox" Content="保留目标管理 IP" IsChecked="True" Margin="0,0,12,0" />
                    <CheckBox x:Name="RebootAfterImportBox" Content="导入后自动重启" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="设备信息" Padding="10" Margin="0,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="软件版本" />
                    <TextBox x:Name="DeviceSoftwareBox" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="1" Text="硬件版本" />
                    <TextBox x:Name="DeviceHardwareBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="2" Text="工程版本" />
                    <TextBox x:Name="DeviceEngineeringBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="3" Text="硬件识别" />
                    <TextBox x:Name="DeviceProfileBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="4" Text="管理 IP" />
                    <TextBox x:Name="DeviceIpBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="5" Text="管理 MAC" />
                    <TextBox x:Name="DeviceMacBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,5" />
                    <TextBlock Grid.Row="6" Text="Feature Hash" />
                    <TextBox x:Name="DeviceFeatureBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True" Margin="4,0,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Header="配置包" Grid.Row="1" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PackagePathBox" IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock x:Name="PackageSummaryBlock" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock x:Name="PackageHashBlock" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="3" Text="上次备份路径" Margin="0,0,0,4" />
                    <TextBox x:Name="BackupPathBox" Grid.Row="4" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>

            <GroupBox Header="差异列表" Grid.Column="1" Grid.RowSpan="2" Padding="10">
                <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="配置包 Hash" Binding="{Binding PackageHash}" Width="230" />
                        <DataGridTextColumn Header="设备 Hash" Binding="{Binding DeviceHash}" Width="230" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <GroupBox Header="操作日志" Grid.Row="3" Padding="10" Margin="0,10,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        </GroupBox>
    </Grid>
</Window>
